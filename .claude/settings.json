{
  "permissions": {
    "allow": [
      "Bash(bash .sdd/bin/sdd:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)"
    ],
    "ask": [
      "Bash(bash .sdd/bin/sdd approve:*)",
      "Bash(bash .sdd/bin/sdd trust:*)",
      "Bash(bash .sdd/bin/sdd resume:*)",
      "Bash(bash .sdd/bin/sdd start:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Edit(.sdd/**)",
      "Edit(~/.claude/sdd-pilot/**)"
    ]
  }
}
