{
  "permissions": {
    "allow": [
      "Bash(bash .sdd/bin/sdd:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)"
    ],
    "ask": [
      "Bash(bash .sdd/bin/sdd approve:*)",
      "Bash(bash .sdd/bin/sdd trust:*)",
      "Bash(bash .sdd/bin/sdd resume:*)",
      "Bash(bash .sdd/bin/sdd start:*)"
    ],
    "deny": [
      "Edit(.sdd/**)",
      "Edit(~/.claude/specsteward/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)"
    ]
  }
}
