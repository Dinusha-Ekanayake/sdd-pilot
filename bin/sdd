#!/usr/bin/env bash
# sdd-pilot launcher: finds a Python 3.11+ (never the Windows Store stub) and runs the CLI.
# Override with SDD_PYTHON=/path/to/python.
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

works() {
  "$@" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

pick_python() {
  if [ -n "${SDD_PYTHON:-}" ]; then
    echo "$SDD_PYTHON"
    return
  fi
  local candidate
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && works "$candidate"; then
      echo "$candidate"
      return
    fi
  done
  if command -v py >/dev/null 2>&1 && works py -3; then
    echo "py -3"
    return
  fi
  echo "sdd-pilot: Python 3.11+ not found. Install it or set SDD_PYTHON." >&2
  exit 127
}

# Hooks fire in every project. Without an sdd.toml at or above the project directory they
# have nothing to do, so leave before starting Python (saves ~100 ms per edit and session).
has_config() {
  local dir="${CLAUDE_PROJECT_DIR:-$PWD}"
  while :; do
    [ -f "$dir/sdd.toml" ] && return 0
    local parent
    parent="$(dirname "$dir")"
    [ "$parent" = "$dir" ] && return 1
    dir="$parent"
  done
}

case "${1:-}" in
  hook-*) has_config || exit 0 ;;
esac

PYTHON="$(pick_python)"
# shellcheck disable=SC2086  # "py -3" must split into two words
exec $PYTHON "$PLUGIN_ROOT/bin/sdd_entry.py" "$@"
